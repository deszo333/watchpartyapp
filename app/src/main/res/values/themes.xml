<resources>
    <!-- Minimal system theme; Compose (ui/theme/Theme.kt) owns real styling.
         This just needs to exist for the manifest reference and to set a
         dark, no-actionbar baseline before Compose takes over. -->
    <style name="Theme.WatchParty" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
